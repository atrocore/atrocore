      "type": "varchar",
      "required": true,
      "view": "views/cluster/fields/master-entity",
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "stagingItemCount": {
      "type": "int",
      "notStorable": true,
      "protected": true
    },
    "masterItemCount": {
      "type": "int",
      "notStorable": true,
      "protected": true
    },
    "status": {
      "type": "enum",
      "notStorable": true,
      "protected": true,
      "options": [
        "empty",
        "review",
        "consolidated",
        "invalid"
      ],
      "optionColors": [
        "eeeeee",
        "b5e8ff",
        "8fff87",
        "ff6262"
      ]
    },
    "consolidationMethod": {
      "type": "enum",
      "protected": true,
      "options": [
        "ruleBased",
        "hybrid",
        "manual"
      ],
      "optionColors": [
        "c4f97f",
        "ffe08a",
        "ffb37c"
      ]
    },
    "executionMode": {
      "type": "enum",
      "protected": true,
      "options": [
        "automatic",
        "manual"
      ],
      "optionColors": [
        "c4f97f",
        "ffb37c"
      ]
    },
    "clusterItems": {
      "type": "linkMultiple",
      "isAuditableRelation": true
    },
    "goldenRecord": {
      "type": "link",
      "layoutNavigationDisabled": true,
      "protected": true,
      "entityNameField": "masterEntity"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "collection": {
    "sortBy": "number",
    "asc": false
  },
  "links": {
    "clusterItems": {
      "type": "hasMany",
      "entity": "ClusterItem",
      "foreign": "cluster"
