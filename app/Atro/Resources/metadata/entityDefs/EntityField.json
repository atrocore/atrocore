{
  "fields": {
    "name": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/name",
      "required": true,
      "trim": true
    },
    "code": {
      "type": "varchar",
      "maxLength": 60,
      "view": "views/admin/field-manager/fields/code",
      "required": true,
      "trim": true,
      "unique": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "type": {
      "type": "varchar",
      "required": true,
      "default": "text",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "entity": {
      "type": "link",
      "required": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "multilangField": {
      "type": "varchar",
      "notStorable": true,
      "readOnly": true
    },
    "customizable": {
      "type": "bool",
      "readOnly": true,
      "default": true
    },
    "isCustom": {
      "type": "bool",
      "readOnly": true
    },
    "entityData": {
      "type": "jsonObject",
      "notStorable": true,
      "layoutListDisabled": true,
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "exportDisabled": true,
      "importDisabled": true,
      "emHidden": true
    },
    "tooltip": {
      "type": "bool"
    },
    "tooltipText": {
      "type": "text",
      "view": "views/admin/field-manager/fields/tooltip-text",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "tooltip"
            }
          ]
        }
      }
    },
    "tooltipLink": {
      "type": "url",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "tooltip"
            }
          ]
        }
      }
    },
    "conditionalVisible": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalProperties": {
      "type": "jsonObject",
      "notStorable": true,
      "view": "views/fields/conditional-properties"
    },
    "data": {
      "type": "jsonObject",
      "layoutListDisabled": true,
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "exportDisabled": true,
      "importDisabled": true
    },
    "entityContainsPersonalData": {
      "type": "bool",
      "notStorable": true,
      "readOnly": true,
      "layoutListDisabled": true,
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "exportDisabled": true,
      "importDisabled": true,
      "emHidden": true
    },
    "personalData": {
      "type": "bool",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        }
      }
    },
    "notInEveryRecord": {
      "type": "bool",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            },
            {
              "type": "isTrue",
              "attribute": "personalData"
            }
          ]
        }
      }
    },
    "category": {
      "type": "enum",
      "options": [
        "identity",
        "contact",
        "location",
        "financial",
        "behavioral",
        "credential",
        "employment",
        "technical",
        "communication"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "personalData"
            }
          ]
        }
      }
    },
    "specialCategory": {
      "type": "bool",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        }
      }
    },
    "specialPersonDataCategory": {
      "type": "enum",
      "options": [
        "origin",
        "political",
        "religious",
        "trade",
        "genetic",
        "biometric",
        "health",
        "sex",
        "orientation"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            },
            {
              "type": "isTrue",
              "attribute": "specialCategory"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "specialCategory"
            }
          ]
        }
      }
    },
    "erasureMode": {
      "type": "enum",
      "options": [
        "anonymize",
        "nullify",
        "retain"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        }
      }
    }
  },
  "links": {
    "entity": {
      "type": "belongsTo",
      "foreign": "fields",
      "entity": "Entity"
    }
  },
  "collection": {
    "sortBy": "code",
    "asc": true
  }
}
