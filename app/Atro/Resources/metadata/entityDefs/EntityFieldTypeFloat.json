{
  "fields": {
    "duplicateIgnore": {
      "type": "bool",
      "tooltip": true
    },
    "required": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "notNull": {
      "type": "bool"
    },
    "readOnly": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "protected"
            }
          ]
        }
      }
    },
    "protected": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "unique": {
      "type": "bool",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "index": {
      "type": "bool",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "measure": {
      "type": "link",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "prefixEnabled": {
      "type": "bool",
      "default": false,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "default": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/value-container",
      "tooltip": true
    },
    "defaultUnit": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/default-unit"
    },
    "min": {
      "type": "float",
      "view": "views/admin/field-manager/fields/value-container",
      "tooltip": true
    },
    "max": {
      "type": "float",
      "view": "views/admin/field-manager/fields/value-container",
      "tooltip": true
    },
    "amountOfDigitsAfterComma": {
      "type": "int",
      "min": 0
    },
    "isNonComparable": {
      "type": "bool"
    },
    "inheritanceDisabled": {
      "view": "views/admin/field-manager/fields/inheritance-disabled",
      "type": "bool",
      "tooltip": true
    },
    "auditableDisabled": {
      "type": "bool",
      "tooltip": true
    },
    "modifiedExtendedDisabled": {
      "type": "bool",
      "tooltip": true
    },
    "conditionalRequired": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalReadOnly": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isEmpty",
              "attribute": "conditionalProtected"
            }
          ]
        }
      }
    },
    "conditionalProtected": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "relevantForAccessRequest": {
      "type": "bool",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        }
      }
    },
    "erasureMode": {
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "entityContainsPersonalData"
            }
          ]
        },
        "disableOptions": [
          {
            "options": [
              "anonymize"
            ],
            "conditionGroup": [
              {
                "type": "isTrue",
                "attribute": "unique"
              },
              {
                "type": "isNotEmpty",
                "attribute": "max"
              }
            ]
          }
        ]
      }
    }
  },
  "links": {
    "measure": {
      "type": "belongsTo",
      "entity": "Measure"
    }
  }
}
