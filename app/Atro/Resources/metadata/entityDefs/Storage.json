{
  "fields": {
    "name": {
      "type": "varchar",
      "notNull": true,
      "required": true,
      "trim": true
    },
    "folder": {
      "type": "link",
      "conditionalProperties": {
        "required": {
          "conditionGroup": [
            {
              "type": "notIn",
              "attribute": "type",
              "value": [
                "local"
              ]
            }
          ]
        }
      }
    },
    "folders": {
      "type": "linkMultiple",
      "noLoad": true
    },
    "files": {
      "type": "linkMultiple",
      "noLoad": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "links": {
    "folder": {
      "type": "belongsTo",
      "entity": "Folder"
    },
    "folders": {
      "type": "hasMany",
      "foreign": "storage",
      "entity": "Folder"
    },
    "files": {
      "type": "hasMany",
      "foreign": "storage",
      "entity": "File"
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "sortBy": "createdAt",
    "asc": false
  },
  "uniqueIndexes": {
    "unique_folder": [
      "deleted",
      "folder_id"
    ]
  }
}