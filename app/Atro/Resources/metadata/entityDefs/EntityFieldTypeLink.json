{
  "fields": {
    "foreignCode": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/foreign-code",
      "trim": true,
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "relationType": {
      "type": "enum",
      "options": [
        "oneToOne",
        "manyToOne"
      ],
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      },
      "required": true
    },
    "foreignEntity": {
      "type": "link",
      "tooltip": true,
      "view": "views/admin/field-manager/fields/foreign-entity",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "duplicateIgnore": {
      "type": "bool",
      "tooltip": true
    },
    "required": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "readOnly": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "protected"
            }
          ]
        }
      }
    },
    "protected": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "default": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/value-container",
      "tooltip": true
    },
    "defaultName": {
      "type": "varchar",
      "notStorable": true,
      "readOnly": true
    },
    "dropdown": {
      "type": "bool",
      "tooltip": true
    },
    "foreignName": {
      "type": "varchar",
      "tooltip": true,
      "view": "views/admin/field-manager/fields/foreign-name"
    },
    "isNonComparable": {
      "type": "bool"
    },
    "inheritanceDisabled": {
      "view": "views/admin/field-manager/fields/inheritance-disabled",
      "type": "bool",
      "tooltip": true
    },
    "auditableDisabled": {
      "type": "bool",
      "tooltip": true
    },
    "modifiedExtendedDisabled": {
      "type": "bool",
      "tooltip": true
    },
    "selectPageSize": {
      "type": "int",
      "min": 10
    },
    "conditionalRequired": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalReadOnly": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isEmpty",
              "attribute": "conditionalProtected"
            }
          ]
        }
      }
    },
    "conditionalProtected": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalDisableOptions": {
      "type": "jsonArray",
      "view": "views/entity-field/fields/conditional-disable-options",
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "customizable"
            }
          ]
        },
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "erasureMode": {
      "options": [
        "delete",
        "retain",
        "cascade",
        "unlink"
      ]
    }
  },
  "links": {
    "foreignEntity": {
      "type": "belongsTo",
      "entity": "Entity"
    }
  }
}
