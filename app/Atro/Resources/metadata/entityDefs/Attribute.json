        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalReadOnly": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "layoutRemoveDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "exportDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isEmpty",
              "attribute": "conditionalProtected"
            }
          ]
        }
      }
    },
    "conditionalProtected": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "layoutRemoveDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "exportDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalVisible": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "layoutRemoveDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "exportDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "conditionalProperties": {
      "type": "jsonObject",
      "notStorable": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "exportDisabled": true,
      "view": "views/fields/conditional-properties"
    },
    "modifiedExtendedDisabled": {
      "type": "bool"
    },
    "duplicateIgnore": {
      "type": "bool",
      "default": false,
      "notNull": true,
      "layoutRemoveDisabled": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "compositeAttribute": {
      "type": "belongsTo",
      "foreign": "nestedAttributes",
      "entity": "Attribute"
    },
    "nestedAttributes": {
      "type": "hasMany",
      "foreign": "compositeAttribute",
      "entity": "Attribute"
    },
    "attributeGroup": {
      "type": "belongsTo",
      "foreign": "attributes",
      "entity": "AttributeGroup"
    },
    "classificationAttributes": {
      "type": "hasMany",
      "foreign": "attribute",
      "entity": "ClassificationAttribute"
    }
  },
  "collection": {
    "sortBy": "createdAt",
    "asc": false,
    "textFilterFields": [
      "name",
      "system_name"
    ]
  },
  "uniqueIndexes": {
    "unique_attribute": [
      "deleted",
      "entity_id",
      "system_name"
    ]
  }
}
