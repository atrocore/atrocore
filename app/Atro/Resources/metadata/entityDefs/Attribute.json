{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "trim": true,
      "isMultilang": true,
      "layoutRemoveDisabled": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "attributeGroup": {
      "type": "link",
      "view": "views/attribute/fields/attribute-group",
      "required": false,
      "readOnly": false,
      "tooltip": false,
      "layoutRemoveDisabled": true
    },
    "attributePanel": {
      "type": "link",
      "entity": "AttributePanel",
      "view": "views/attribute/fields/attribute-panel",
      "required": true,
      "layoutRemoveDisabled": true
    },
    "entity": {
      "type": "link",
      "entity": "Entity",
      "required": true,
      "view": "views/attribute/fields/entity",
      "layoutRemoveDisabled": true,
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "systemName": {
      "type": "varchar",
      "view": "views/admin/field-manager/fields/code",
      "required": true,
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "type": {
      "massUpdateDisabled": true,
      "view": "views/attribute/fields/type",
      "layoutRemoveDisabled": true
    },
    "compositeAttribute": {
      "type": "link",
      "view": "views/attribute/fields/composite-attribute"
    },
    "nestedAttributes": {
      "type": "linkMultiple"
    },
    "classificationAttributes": {
      "type": "linkMultiple",
      "layoutListDisabled": true,
      "layoutListSmallDisabled": true,
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "noLoad": true,
      "importDisabled": true
    },
    "data": {
      "type": "jsonObject",
      "layoutListDisabled": true,
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "exportDisabled": true,
      "importDisabled": true,
      "emHidden": true
    },
    "isRequired": {
      "type": "bool",
      "default": false,
      "layoutRemoveDisabled": true,
      "view": "views/attribute/fields/required"
    },
    "isReadOnly": {
      "type": "bool",
      "default": false,
      "layoutRemoveDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isFalse",
              "attribute": "isProtected"
            }
          ]
        }
      }
    },
    "isProtected": {
      "type": "bool",
      "default": false,
      "layoutRemoveDisabled": true
    },
    "sortOrder": {
      "type": "int",
      "default": null
    },
    "attributeGroupSortOrder": {
      "type": "int",
      "default": null
    },
    "tooltip": {
      "type": "text",
      "isMultilang": true,
      "trim": true,
      "layoutListDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true
    },
    "description": {
      "type": "text",
      "rowsMax": 4,
      "lengthOfCut": 400,
      "isMultilang": true
    },
    "fullWidth": {
      "type": "bool",
      "notStorable": true,
      "virtualField": true,
      "filterDisabled": true,
      "massUpdateDisabled": true,
      "layoutListDisabled": true,
      "default": false,
      "layoutRemoveDisabled": true,
      "emHidden": true,
      "conditionalProperties": {
        "readOnly": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "type",
              "value": [
                "composite"
              ]
            }
          ]
        }
      }
    },
    "conditionalRequired": {
      "type": "jsonObject",
      "view": "views/admin/field-manager/fields/conditions-container",
      "layoutRemoveDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "exportDisabled": true,
