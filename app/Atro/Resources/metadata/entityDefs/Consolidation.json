{
  "fields": {
    "number": {
      "type": "autoincrement"
    },
    "entity": {
      "type": "link",
      "entity": "Entity",
      "selectBoolFilterList": [
        "onlyConsolidation"
      ],
      "required": true,
      "customizable": false,
      "layoutRemoveDisabled": true,
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "updateMasterAutomatically": {
      "type": "bool",
      "default": false
    },
    "executeConsolidationAs": {
      "type": "enum",
      "default": "system",
      "options": [
        "system",
        "sameUser"
      ],
      "tooltip": true
    },
    "skipCondition": {
      "type": "code",
      "notStorable": true,
      "engine": "ExpressionLanguage",
      "variables": [
        "candidate",
        "masterRecord"
      ],
      "filterDisabled": true,
      "massUpdateDisabled": true,
      "importDisabled": true,
      "customizable": false,
      "tooltip": true
    },
    "consolidationScript": {
      "type": "code",
      "engine": "Twig",
      "language": "json",
      "default": "{# { \"name\": \"{{ (candidates|last).name }}\" } #}",
      "editorActions": {
        "addFields": {
          "entityNameField": "name"
        },
        "addAttributes": {
          "entityNameField": "name"
        }
      },
      "variables": [
        "candidates",
        "contributors",
        "masterRecord"
      ],
      "customizable": false,
      "layoutRemoveDisabled": true,
      "tooltip": true
    },
    "consolidateAutomatically": {
      "type": "bool"
    },
    "deleteInvalidMastersAutomatically": {
      "type": "bool"
    },
    "minimumMatchingScore": {
      "type": "int",
      "default": 100,
      "min": 1,
      "max": 100,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "consolidateAutomatically"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "consolidateAutomatically"
            }
          ]
        }
      }
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "indexes": {
    "createdAt": {
      "columns": [
        "createdAt",
        "deleted"
      ]
    },
    "modifiedAt": {
      "columns": [
        "modifiedAt",
        "deleted"
      ]
    }
  },
  "uniqueIndexes": {
    "unique_entity": [
      "deleted",
      "entity_id"
    ]
  }
}