{
  "fields": {
    "sortBy": {
      "type": "varchar",
      "view": "views/admin/entity-manager/fields/sort-by",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isTrue",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "sortDirection": {
      "type": "enum",
      "options": [
        "asc",
        "desc"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isTrue",
              "attribute": "customizable"
            }
          ]
        }
      }
    },
    "quickActions": {
      "type": "multiEnum",
      "view": "views/admin/entity-manager/fields/quick-actions"
    },
    "disableActionHistory": {
      "type": "bool",
      "tooltip": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isTrue",
              "attribute": "customizable"
            },
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            }
          ]
        }
      }
    },
    "createDisabled": {
      "type": "bool",
      "default": false
    },
    "editDisabled": {
      "type": "bool",
      "default": false
    },
    "deleteDisabled": {
      "type": "bool",
      "default": false
    },
    "auditedDisabledFields": {
      "type": "array",
      "view": "views/admin/entity-manager/fields/audited-disabled-fields",
      "notStorable": true,
      "tooltip": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isTrue",
              "attribute": "customizable"
            },
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            }
          ]
        }
      }
    },
    "auditedEnabledRelations": {
      "type": "array",
      "view": "views/admin/entity-manager/fields/audited-enabled-relations",
      "notStorable": true,
      "tooltip": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            },
            {
              "type": "isTrue",
              "attribute": "customizable"
            },
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            }
          ]
        }
      }
    },
    "nonDuplicatableFields": {
      "type": "array",
      "view": "views/admin/entity-manager/fields/non-duplicatable-fields",
      "notStorable": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            },
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "textFilterFields": {
      "type": "array",
      "view": "views/admin/entity-manager/fields/text-filter-fields",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            },
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "containsPersonalData": {
      "type": "bool"
    },
    "isPerson": {
      "type": "bool",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "containsPersonalData"
            }
          ]
        }
      }
