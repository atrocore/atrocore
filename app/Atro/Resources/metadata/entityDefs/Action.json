      "view": "views/action/fields/type",
      "required": true,
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "typePhpCode": {
      "type": "wysiwyg",
      "readOnly": true,
      "notStorable": true,
      "layoutDetailDisabled": true,
      "layoutListDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "textFilterDisabled": true,
      "openApiEnabled": true
    },
    "conditionPhpCode": {
      "type": "wysiwyg",
      "readOnly": true,
      "notStorable": true,
      "layoutDetailDisabled": true,
      "layoutListDisabled": true,
      "massUpdateDisabled": true,
      "filterDisabled": true,
      "importDisabled": true,
      "textFilterDisabled": true,
      "openApiEnabled": true
    },
    "executeAs": {
      "type": "enum",
      "default": "system",
      "options": [
        "system",
        "sameUser"
      ],
      "tooltip": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "notIn",
              "attribute": "type",
              "value": [
                "suggestValue"
              ]
            }
          ]
        }
      }
    },
    "sourceEntity": {
      "type": "varchar",
      "view": "views/action/fields/source-entity",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "usage",
              "value": [
                "entity",
                "record",
                "field",
                "onFieldFocus",
                "onFieldChange",
                "onRecordLoad"
              ]
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "usage",
              "value": [
                "entity",
                "record",
                "field",
                "onFieldFocus",
                "onFieldChange",
                "onRecordLoad"
              ]
            }
          ]
        },
        "readOnly": {
          "conditionGroup": [
            {
              "type": "isTrue",
              "attribute": "applyToPreselectedRecords"
            },
            {
              "type": "in",
              "attribute": "type",
              "value": [
                "update",
                "delete"
              ]
            }
          ]
        }
      }
    },
    "conditionsType": {
      "type": "varchar",
      "view": "views/action/fields/conditions-type",
      "conditionalProperties": {
        "disableOptions": [
          {
            "options": [
              "basic"
            ],
            "conditionGroup": [
              {
                "type": "isEmpty",
                "attribute": "sourceEntity"
              },
              {
                "type": "isEmpty",
                "attribute": "targetEntity"
              }
            ]
          }
        ]
      }
    },
