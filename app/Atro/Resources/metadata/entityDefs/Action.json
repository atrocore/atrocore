  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "actionsSet": {
      "type": "hasMany",
      "relationName": "actionSetLinker",
      "foreign": "actions",
      "entity": "Action",
      "midKeys": [
        "setId",
        "actionId"
      ]
    },
    "actions": {
      "type": "hasMany",
      "relationName": "actionSetLinker",
      "foreign": "actionsSet",
      "entity": "Action",
      "midKeys": [
        "actionId",
        "setId"
      ]
    },
    "executions": {
