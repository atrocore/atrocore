        "required": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "usage",
              "value": [
                "field"
              ]
            }
          ]
        }
      }
    },
    "display": {
      "type": "enum",
      "options": [
        "dropdown",
        "single"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "usage",
              "value": [
                "entity",
                "record"
              ]
            }
          ]
        },
        "disableOptions": [
          {
            "options": [
              "dropdown"
            ],
            "conditionGroup": [
              {
                "type": "equals",
