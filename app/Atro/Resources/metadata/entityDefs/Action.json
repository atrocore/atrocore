        "disableOptions": [
          {
            "options": [
              "entity",
              "field"
            ],
            "conditionGroup": [
              {
                "type": "equals",
                "attribute": "type",
                "value": "suggestValue"
              }
            ]
          },
          {
            "options": [
              "onFieldFocus",
              "onFieldChange",
              "onRecordLoad"
            ],
            "conditionGroup": [
              {
                "type": "notIn",
                "attribute": "type",
                "value": [
                  "suggestValue"
                ]
              }
            ]
          }
        ]
      }
    },
    "focusField": {
      "type": "enum",
      "view": "views/fields/entity-field",
