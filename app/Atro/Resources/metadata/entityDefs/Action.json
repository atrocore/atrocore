      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "equals",
              "attribute": "usage",
              "value": "onFieldFocus"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "equals",
              "attribute": "usage",
              "value": "onFieldFocus"
            }
          ]
        }
      }
    },
    "changeFields": {
      "type": "multiEnum",
      "view": "views/fields/entity-fields",
      "notStorable": true,
      "virtualField": true,
      "entityField": "sourceEntity",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "equals",
              "attribute": "usage",
              "value": "onFieldChange"
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "equals",
              "attribute": "usage",
