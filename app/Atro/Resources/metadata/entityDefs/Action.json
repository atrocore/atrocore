      "type": "jsonObject",
      "view": "views/action/fields/conditions-container",
      "filterDisabled": true,
      "massUpdateDisabled": true,
      "importDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "conditionsType",
              "value": [
                "basic"
              ]
            }
          ]
        },
        "readOnly": {
          "conditionGroup": [
            {
              "type": "notIn",
              "attribute": "conditionsType",
              "value": [
                "basic"
              ]
            }
          ]
        }
      }
    },
    "conditionsExpression": {
      "type": "code",
      "notStorable": true,
      "engine": "ExpressionLanguage",
      "variables": [
        "entity",
        "uiRecord",
        "uiRecordFromName",
        "uiRecordFrom"
      ],
      "filterDisabled": true,
      "massUpdateDisabled": true,
      "importDisabled": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "conditionsType",
              "value": [
                "expression"
              ]
            }
          ]
        },
        "required": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "conditionsType",
              "value": [
                "expression"
              ]
            }
          ]
        }
      }
    },
    "conditionsScript": {
      "type": "code",
      "engine": "Twig",
      "readOnly": true,
      "filterDisabled": true,
      "massUpdateDisabled": true,
      "importDisabled": true,
      "variables": [
        "entity",
        "uiRecord",
        "uiRecordFromName",
        "uiRecordFrom"
      ],
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "conditionsType",
