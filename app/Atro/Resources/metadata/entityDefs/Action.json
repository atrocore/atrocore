    "inBackground": {
      "type": "bool",
      "default": false,
      "tooltip": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "notIn",
              "attribute": "type",
              "value": [
                "suggestValue",
                "updateByAi",
                "suggestValueByAi",
                "error"
              ]
            }
          ]
        },
        "protected": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "type",
              "value": [
                "suggestValue",
                "updateByAi",
                "suggestValueByAi",
                "error"
              ]
            }
          ]
        }
      }
    },
    "massAction": {
      "type": "bool",
      "default": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "in",
              "attribute": "usage",
              "value": [
                "record"
              ]
            },
            {
              "type": "isNotEmpty",
              "attribute": "sourceEntity"
            },
            {
              "type": "notEquals",
              "attribute": "type",
              "value": "suggestValue"
            }
          ]
        }
      }
    },
    "usage": {
      "type": "enum",
      "inlineEditDisabled": true,
      "options": [
        "entity",
        "record",
        "field",
        "onFieldFocus",
        "onFieldChange",
        "onRecordLoad"
      ],
