{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "trim": true
    },
    "namePlural": {
      "type": "varchar",
      "required": true,
      "trim": true
    },
    "code": {
      "type": "varchar",
      "maxLength": 30,
      "view": "views/admin/entity-manager/fields/code",
      "required": true,
      "trim": true,
      "unique": true,
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "isNotEmpty",
              "attribute": "id"
            }
          ]
        }
      }
    },
    "type": {
      "type": "enum",
      "required": true,
      "options": [
        "Base",
        "Hierarchy",
        "Subtype"
      ],
      "conditionalProperties": {
        "protected": {
          "conditionGroup": [
            {
              "type": "or",
              "value": [
                {
                  "type": "isNotEmpty",
                  "attribute": "id"
                },
                {
                  "type": "isNotEmpty",
                  "attribute": "primaryEntityId"
                }
              ]
            }
          ]
        }
      }
    },
    "iconClass": {
      "type": "varchar",
      "view": "views/admin/entity-manager/fields/icon-class"
    },
    "customizable": {
      "type": "bool",
      "notStorable": true,
      "readOnly": true,
      "default": true
    },
    "description": {
      "type": "text",
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            }
          ]
        }
      }
    },
    "matchingDisabled": {
      "type": "bool",
      "protected": true
    },
    "isSystem": {
      "type": "bool",
      "notStorable": true
    },
    "isCustom": {
      "type": "bool",
      "readOnly": true,
      "conditionalProperties": {
        "visible": {
          "conditionGroup": [
            {
              "type": "isEmpty",
              "attribute": "primaryEntityId"
            }
          ]
        }
      }
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "fields": {
      "type": "linkMultiple",
      "layoutDetailDisabled": true,
      "massUpdateDisabled": true,
      "noLoad": true
    },
    "onlyEditableEmFields": {
      "type": "array",
      "notStorable": true
    },
    "attributesDisabled": {
      "type": "bool",
      "notStorable": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "fields": {
      "type": "hasMany",
      "foreign": "entity",
      "entity": "EntityField"
    }
  },
  "collection": {
    "sortBy": "code",
    "asc": true
  }
}
